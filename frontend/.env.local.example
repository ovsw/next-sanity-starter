# used for sitemap.ts , robots.ts , and for client.ts
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# used for Draft Mode (Open in Studio Url)
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
# used for metadata to set robots (you can set development for you testing subdomain)
NEXT_PUBLIC_SITE_ENV=development
# Resend to send contact form submissions
RESEND_API_KEY=your-project-key
NEXT_RESEND_TO_EMAIL=your-email-to-receive-contact-submission
NEXT_RESEND_FROM_EMAIL=your-email-to-send-contact-submissions

# SANITY CMS
# use current date (YYYY-MM-DD) to target the latest API version
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=development
# Required in every environment. Signs OG image URLs so callers cannot create arbitrary render work.
OG_IMAGE_SECRET=generate-a-long-random-value
# Required for Sanity draft previews. Published content is public.
SANITY_API_READ_TOKEN=your-token

# shadcnblocks.com registry key, used by the shadcn CLI/MCP to install blocks
SHADCNBLOCKS_API_KEY=your-key

# YouTube Data API v3 key (restrict it to that API), used to build VideoObject
# JSON-LD for embedded videos. Optional: without it the schema is skipped.
YOUTUBE_API_KEY=your-youtube-data-api-key
