# Required local identity and Sanity connection values.
NEXT_PUBLIC_SITE_NAME="Next.js + Sanity Starter"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
OG_IMAGE_SECRET=generate-a-long-random-value

# Optional. Required only for Sanity draft previews.
SANITY_API_READ_TOKEN=your-read-token

# Optional contact form email delivery.
RESEND_API_KEY=your-resend-key
NEXT_RESEND_TO_EMAIL=recipient@example.com
NEXT_RESEND_FROM_EMAIL=sender@example.com

# Optional editor tooling and video metadata.
SHADCNBLOCKS_API_KEY=your-key
YOUTUBE_API_KEY=your-youtube-data-api-key
