# Required local identity and Sanity connection values.
NEXT_PUBLIC_SITE_NAME="Your Site Name"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3333
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-23
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
OG_IMAGE_SECRET=generate-a-long-random-value
SANITY_API_READ_TOKEN=your-read-token
# Lets the Sanity Function that refreshes content on publish call the
# Website. Only the deployed Website needs it; see docs/deployment.md.
SANITY_REVALIDATE_SECRET=

# Optional editor tooling.
SHADCNBLOCKS_API_KEY=your-key
